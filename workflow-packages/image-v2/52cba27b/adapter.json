{
  "engineApiVersion": 2,
  "capability": "image-generation",
  "variant": "image-edit",
  "operations": {
    "generate": {
      "label": "生成",
      "inputs": [
        {
          "id": "prompt",
          "type": "text",
          "label": "提示词",
          "min": 1,
          "max": 1,
          "order": 2
        },
        {
          "id": "images",
          "type": "image",
          "label": "编辑图片",
          "min": 1,
          "max": 2,
          "order": 1
        }
      ],
      "outputs": [
        {
          "id": "image",
          "type": "image",
          "min": 0,
          "max": 1
        }
      ],
      "controls": [
        {
          "id": "modelName",
          "type": "select",
          "label": "模型",
          "default": "Krea2\\pornmasterKrea2_v2TurboBF16.safetensors",
          "options": {
            "comfyui": {
              "classType": "UNETLoader",
              "input": "unet_name",
              "dirs": [
                "Krea2",
                "Kera2"
              ]
            }
          },
          "emptyMeansDefault": true,
          "setting": "diffusionModelName"
        },
        {
          "id": "negativePrompt",
          "type": "textarea",
          "label": "负向提示词",
          "default": "",
          "help": "可选：直接输入不希望出现的内容"
        },
        {
          "id": "width",
          "type": "number",
          "label": "宽度",
          "default": 1280,
          "min": 64.0,
          "max": 4096.0,
          "number": "int",
          "group": "size",
          "unit": "px",
          "increment": 64.0
        },
        {
          "id": "height",
          "type": "number",
          "label": "高度",
          "default": 720,
          "min": 64.0,
          "max": 4096.0,
          "number": "int",
          "group": "size",
          "unit": "px",
          "increment": 64.0
        },
        {
          "id": "steps",
          "type": "number",
          "label": "生图步数",
          "default": 8,
          "min": 1.0,
          "max": 1000.0,
          "number": "int",
          "group": "sampling",
          "help": "基础文生图 K 采样器的采样步数"
        },
        {
          "id": "seed",
          "type": "seed",
          "label": "种子"
        }
      ],
      "groups": [
        {
          "id": "size",
          "swap": true
        },
        {
          "id": "sampling"
        }
      ],
      "steps": [
        {
          "op": "set",
          "node": "500",
          "input": "filename_prefix",
          "value": {
            "date": {
              "const": "%date:yyyy-MM-dd%/ComfyUI_krea2_image_edit"
            }
          }
        },
        {
          "op": "set",
          "node": "43",
          "input": "unet_name",
          "value": {
            "path": {
              "control": "modelName"
            }
          }
        },
        {
          "op": "set",
          "node": "18",
          "input": "unet_name",
          "value": {
            "path": {
              "control": "modelName"
            }
          }
        },
        {
          "op": "set",
          "node": "42",
          "input": "lora_name",
          "value": {
            "const": "Krea2\\krea2_identity_edit_v1_2.safetensors"
          }
        },
        {
          "op": "set",
          "node": "17",
          "input": "lora_name",
          "value": {
            "const": "Krea2\\krea2_identity_edit_v1_2.safetensors"
          }
        },
        {
          "op": "set",
          "node": "45",
          "input": "image",
          "value": {
            "media": {
              "port": "images",
              "index": 0
            }
          },
          "when": {
            "not": {
              "mediaAtLeast": {
                "port": "images",
                "count": 2
              }
            }
          }
        },
        {
          "op": "set",
          "node": "500",
          "input": "images",
          "value": {
            "link": [
              "29",
              0
            ]
          },
          "when": {
            "not": {
              "mediaAtLeast": {
                "port": "images",
                "count": 2
              }
            }
          }
        },
        {
          "op": "set",
          "node": "28",
          "input": "width",
          "value": {
            "int": {
              "control": "width"
            }
          },
          "when": {
            "not": {
              "mediaAtLeast": {
                "port": "images",
                "count": 2
              }
            }
          }
        },
        {
          "op": "set",
          "node": "28",
          "input": "height",
          "value": {
            "int": {
              "control": "height"
            }
          },
          "when": {
            "not": {
              "mediaAtLeast": {
                "port": "images",
                "count": 2
              }
            }
          }
        },
        {
          "op": "set",
          "node": "21",
          "input": "image",
          "value": {
            "media": {
              "port": "images",
              "index": 0
            }
          },
          "when": {
            "mediaAtLeast": {
              "port": "images",
              "count": 2
            }
          }
        },
        {
          "op": "set",
          "node": "9",
          "input": "image",
          "value": {
            "media": {
              "port": "images",
              "index": 1
            }
          },
          "when": {
            "mediaAtLeast": {
              "port": "images",
              "count": 2
            }
          }
        },
        {
          "op": "set",
          "node": "4",
          "input": "width",
          "value": {
            "int": {
              "control": "width"
            }
          },
          "when": {
            "mediaAtLeast": {
              "port": "images",
              "count": 2
            }
          }
        },
        {
          "op": "set",
          "node": "4",
          "input": "height",
          "value": {
            "int": {
              "control": "height"
            }
          },
          "when": {
            "mediaAtLeast": {
              "port": "images",
              "count": 2
            }
          }
        },
        {
          "op": "set",
          "node": "500",
          "input": "images",
          "value": {
            "link": [
              "6",
              0
            ]
          },
          "when": {
            "mediaAtLeast": {
              "port": "images",
              "count": 2
            }
          }
        },
        {
          "op": "set",
          "node": "37",
          "input": "value",
          "value": {
            "trim": {
              "media": {
                "port": "prompt",
                "index": 0
              }
            }
          }
        },
        {
          "op": "set",
          "node": "20",
          "input": "value",
          "value": {
            "trim": {
              "media": {
                "port": "prompt",
                "index": 0
              }
            }
          }
        },
        {
          "op": "set",
          "node": "34",
          "input": "prompt",
          "value": {
            "trim": {
              "control": "negativePrompt"
            }
          }
        },
        {
          "op": "set",
          "node": "3",
          "input": "prompt",
          "value": {
            "trim": {
              "control": "negativePrompt"
            }
          }
        },
        {
          "op": "set",
          "node": "30",
          "input": "seed",
          "value": {
            "seed": true
          },
          "create": true
        },
        {
          "op": "set",
          "node": "30",
          "input": "steps",
          "value": {
            "int": {
              "control": "steps"
            }
          }
        },
        {
          "op": "set",
          "node": "30",
          "input": "cfg",
          "value": {
            "if": {
              "cond": {
                "empty": {
                  "trim": {
                    "control": "negativePrompt"
                  }
                }
              },
              "then": {
                "const": 1.0
              },
              "else": {
                "const": 1.5
              }
            }
          }
        },
        {
          "op": "set",
          "node": "7",
          "input": "seed",
          "value": {
            "seed": true
          },
          "create": true
        },
        {
          "op": "set",
          "node": "7",
          "input": "steps",
          "value": {
            "int": {
              "control": "steps"
            }
          }
        },
        {
          "op": "set",
          "node": "7",
          "input": "cfg",
          "value": {
            "if": {
              "cond": {
                "empty": {
                  "trim": {
                    "control": "negativePrompt"
                  }
                }
              },
              "then": {
                "const": 1.0
              },
              "else": {
                "const": 1.5
              }
            }
          }
        }
      ],
      "record": {
        "modelName": {
          "input": {
            "node": "43",
            "input": "unet_name"
          }
        }
      }
    }
  }
}
