        {
          "id": "primaryAudioSteps",
          "type": "number",
          "label": "1采 Audio Steps",
          "default": 8,
          "min": 1.0,
          "number": "int"
        },
        {
          "id": "secondarySchedulerSteps",
          "type": "number",
          "label": "2采 Steps",
          "default": 4,
          "min": 1.0,
          "number": "int"
        },
        {
          "id": "primaryUpscaleFactor",
          "type": "number",
          "label": "1采放大倍率",
          "default": 1.0,
          "min": 1.0,
          "max": 4.0,
          "number": "float"
        },
        {
          "id": "primaryBrightness",
          "type": "number",
          "label": "1采亮度",
          "default": 1.0,
          "min": 0.0,
          "max": 3.0,
          "number": "float"
        },
        {
          "id": "primaryContrast",
          "type": "number",
          "label": "1采对比度",
          "default": 0.9,
          "min": 0.0,
          "max": 3.0,
          "number": "float"
        },
        {
          "id": "primarySaturation",
          "type": "number",
          "label": "1采饱和度",
          "default": 0.9,
          "min": 0.0,
          "max": 3.0,
          "number": "float"
        },
        {
          "id": "secondaryBrightness",
          "type": "number",
          "label": "2采亮度",
          "default": 1.0,
          "min": 0.0,
          "max": 3.0,
          "number": "float"
        },
        {
          "id": "secondaryContrast",
          "type": "number",
          "label": "2采对比度",
          "default": 0.9,
          "min": 0.0,
          "max": 3.0,
          "number": "float"
        },
        {
          "id": "secondarySaturation",
          "type": "number",
          "label": "2采饱和度",
          "default": 1.0,
          "min": 0.0,
          "max": 3.0,
          "number": "float"
        },
        {
          "id": "secondarySamplingEnabled",
          "type": "toggle",
          "label": "2采",
          "default": false
        },
        {
          "id": "diffusionModelName",
          "type": "select",
          "label": "基础模型",
          "default": "",
          "options": {
            "comfyui": {
              "classType": "UNETLoader",
              "input": "unet_name",
              "dirs": [
                "MinimaxH3"
              ]
            }
          }
        },
        {
          "id": "loraName",
          "type": "select",
          "label": "LoRA",
          "default": "",
          "options": {
            "comfyui": {
              "classType": "LoraLoaderModelOnly",
              "input": "lora_name",
              "dirs": [
                "MinimaxH3"
              ]
            }
          },
          "allowEmpty": true
        },
        {
          "id": "loraStrength",
          "type": "number",
          "label": "LoRA 权重",
          "default": 1.0,
          "min": 0.0,
          "max": 10.0,
          "number": "float"
        },
        {
          "id": "loraBypassed",
          "type": "toggle",
          "label": "LoRA Bypass",
          "default": false
        },
        {
          "id": "secondaryLoraName",
          "type": "select",
          "label": "2采 LoRA",
          "default": "",
          "options": {
            "comfyui": {
              "classType": "LoraLoaderModelOnly",
              "input": "lora_name",
              "dirs": [
                "MinimaxH3"
              ]
            }
          },
          "allowEmpty": true
        },
        {
          "id": "secondaryLoraStrength",
          "type": "number",
          "label": "2采 LoRA 权重",
          "default": 1.0,
          "min": 0.0,
          "max": 10.0,
          "number": "float"
        },
        {
          "id": "secondaryLoraBypassed",
          "type": "toggle",
          "label": "2采 LoRA Bypass",
          "default": false
        },
        {
          "id": "styleLoras",
          "type": "repeat",
          "label": "风格 LoRA",
          "max": 6.0,
          "fields": [
            {
              "id": "name",
              "type": "select",
              "label": "LoRA",
              "default": "",
              "options": {
                "comfyui": {
                  "classType": "LoraLoaderModelOnly",
                  "input": "lora_name",
                  "dirs": [
                    "MinimaxH3"
                  ]
                }
              },
              "allowEmpty": true
            },
            {
              "id": "strength",
              "type": "number",
              "label": "权重",
              "default": 1.0,
              "min": 0.0,
              "max": 10.0,
              "number": "float"
            },
            {
              "id": "on",
              "type": "toggle",
              "label": "启用",
              "default": true
            },
            {
              "id": "toSecondary",
              "type": "toggle",
              "label": "应用到二段",
              "default": false
            },
            {
              "id": "toSecondPass",
              "type": "toggle",
              "label": "应用到2采",
              "default": false
            }
          ]
        },
        {
          "id": "refImageSize",
          "type": "select",
          "label": "参考图尺寸",
          "default": "max",
          "options": {
            "values": [
              {
                "value": "max"
              },
              {
                "value": "match"
              }
            ]
          }
        },
        {
          "id": "seed",
          "type": "seed",
          "label": "种子"
        }
      ],
      "steps": [
        {
          "op": "set",
          "node": "127",
          "input": "unet_name",
          "value": {
            "trim": {
              "control": "diffusionModelName"
            }
          }
        },
        {
          "op": "set",
          "node": "358",
          "input": "unet_name",
          "value": {
            "trim": {
              "control": "diffusionModelName"
            }
          }
        },
        {
          "op": "set",
          "node": "138",
          "input": "value",
          "value": {
            "control": "prompt"
          }
        },
        {
          "op": "set",
          "node": "129",
          "input": "noise_seed",
          "value": {
            "seed": true
