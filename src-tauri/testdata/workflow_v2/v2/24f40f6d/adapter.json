        {
          "id": "durationSeconds",
          "type": "number",
          "label": "时长",
          "default": 5.0,
          "min": 2.0,
          "max": 15.0,
          "number": "float"
        },
        {
          "id": "aspectRatio",
          "type": "select",
          "label": "画面比例",
          "default": "16:9",
          "options": {
            "values": [
              {
                "value": "16:9"
              },
              {
                "value": "9:16"
              },
              {
                "value": "4:3"
              },
              {
                "value": "3:4"
              },
              {
                "value": "2:3"
              },
              {
                "value": "3:2"
              },
              {
                "value": "1:1"
              }
            ]
          }
        },
        {
          "id": "primaryResolutionMegapixels",
          "type": "number",
          "label": "1采分辨率",
          "default": 0.4,
          "min": 0.2,
          "max": 2.0,
          "number": "float"
        },
        {
          "id": "secondaryResolutionMegapixels",
          "type": "number",
          "label": "2采分辨率",
          "default": 0.5,
          "min": 0.2,
          "max": 2.0,
          "number": "float"
        },
        {
          "id": "primaryVideoSteps",
          "type": "number",
