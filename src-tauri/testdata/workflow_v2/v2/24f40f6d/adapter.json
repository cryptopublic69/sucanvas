    "358": "UNETLoader",
    "401": "LoraLoaderModelOnly",
    "9200": "LoraLoaderModelOnly",
    "9201": "LoraLoaderModelOnly",
    "9202": "SolAttnMiniMax",
    "9500": "LoraLoaderModelOnly",
    "9501": "LoraLoaderModelOnly",
    "9502": "LoraLoaderModelOnly",
    "9503": "LoraLoaderModelOnly",
    "9504": "LoraLoaderModelOnly",
    "9505": "LoraLoaderModelOnly",
    "9506": "LoraLoaderModelOnly",
    "9507": "LoraLoaderModelOnly",
    "9508": "LoraLoaderModelOnly",
    "9509": "LoraLoaderModelOnly",
    "9600": "LoraLoaderModelOnly",
    "9601": "LoraLoaderModelOnly",
    "9602": "LoraLoaderModelOnly",
    "9603": "LoraLoaderModelOnly",
    "9604": "LoraLoaderModelOnly",
    "9605": "LoraLoaderModelOnly"
