              "then": {
                "var": "primaryUpstream"
              },
              "else": {
                "link": [
                  "147",
                  0
                ]
              }
            }
          }
        },
        {
          "op": "chain",
          "id": "first",
          "repeat": "styleLoras",
          "slots": [
            "9200",
            "9500",
            "9502",
            "9504",
            "9506",
            "9508"
          ],
          "linkInput": "model",
          "itemWhen": {
            "truthy": {
              "item": "on"
            }
          },
          "fields": {
            "lora_name": {
              "trim": {
                "item": "name"
              }
            },
            "strength_model": {
              "float": {
                "item": "strength"
              }
            }
          },
          "from": {
            "link": [
              "141",
              0
            ]
          },
          "to": [
            {
              "node": "126",
              "input": "model"
            }
          ]
        },
        {
          "op": "chain",
          "id": "second",
          "repeat": "styleLoras",
          "slots": [
            "9600",
            "9601",
            "9602",
            "9603",
            "9604",
            "9605"
          ],
          "linkInput": "model",
          "itemWhen": {
            "all": [
              {
                "truthy": {
                  "item": "on"
                }
              },
              {
                "truthy": {
                  "item": "toSecondary"
                }
              }
            ]
          },
          "fields": {
            "lora_name": {
              "trim": {
                "item": "name"
              }
            },
            "strength_model": {
              "float": {
                "item": "strength"
              }
            }
          },
          "from": {
            "link": [
              "141",
              0
            ]
          },
          "to": [
            {
              "node": "9606",
              "input": "model"
            }
          ]
        },
        {
          "op": "chain",
          "id": "secondaryStyle",
          "repeat": "styleLoras",
          "slots": [
            "9201",
            "9501",
            "9503",
            "9505",
            "9507",
            "9509"
          ],
          "linkInput": "model",
          "itemWhen": {
            "all": [
              {
                "truthy": {
                  "item": "on"
                }
              },
              {
                "truthy": {
                  "item": "toSecondPass"
                }
              }
            ]
          },
          "fields": {
            "lora_name": {
              "trim": {
                "item": "name"
              }
            },
            "strength_model": {
              "float": {
                "item": "strength"
              }
            }
