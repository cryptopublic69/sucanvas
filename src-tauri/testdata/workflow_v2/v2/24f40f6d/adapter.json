            "map": {
              "value": {
                "trim": {
                  "control": "aspectRatio"
                }
              },
              "table": {
                "16:9": "16:9 (Widescreen)",
                "1:1": "1:1 (Square)",
                "2:3": "2:3 (Portrait Photo)",
                "3:2": "3:2 (Photo)",
                "3:4": "3:4 (Portrait Standard)",
                "4:3": "4:3 (Standard)",
                "9:16": "9:16 (Portrait Widescreen)"
              }
            }
          }
        },
        {
          "op": "set",
          "node": "115",
          "input": "megapixels",
          "value": {
            "float": {
              "control": "primaryResolutionMegapixels"
            }
          }
        },
        {
          "op": "set",
          "node": "398",
          "input": "aspect_ratio",
          "value": {
            "map": {
              "value": {
                "trim": {
                  "control": "aspectRatio"
                }
              },
              "table": {
                "16:9": "16:9 (Widescreen)",
                "1:1": "1:1 (Square)",
                "2:3": "2:3 (Portrait Photo)",
                "3:2": "3:2 (Photo)",
                "3:4": "3:4 (Portrait Standard)",
                "4:3": "4:3 (Standard)",
                "9:16": "9:16 (Portrait Widescreen)"
              }
            }
          },
          "when": {
            "any": [
              {
                "truthy": {
                  "control": "secondarySamplingEnabled"
                }
              },
              {
                "mediaAtLeast": {
                  "port": "secondarySource",
                  "count": 1
                }
              }
            ]
          }
        },
        {
          "op": "set",
          "node": "398",
          "input": "megapixels",
          "value": {
            "float": {
              "control": "secondaryResolutionMegapixels"
            }
          },
          "when": {
            "any": [
              {
                "truthy": {
                  "control": "secondarySamplingEnabled"
                }
              },
              {
                "mediaAtLeast": {
                  "port": "secondarySource",
                  "count": 1
                }
              }
            ]
          }
        },
        {
          "op": "set",
          "node": "124",
          "input": "steps",
