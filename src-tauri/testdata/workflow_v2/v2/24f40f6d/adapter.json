  "operations": {
    "generate": {
      "label": "生成",
      "inputs": [
        {
          "id": "images",
          "type": "image",
          "min": 0,
          "max": 9
        },
        {
          "id": "audios",
          "type": "audio",
          "min": 0,
          "max": 3
        },
        {
          "id": "secondarySource",
          "type": "video",
          "label": "二采源视频",
          "min": 0,
          "max": 1
        }
      ],
      "outputs": [
        {
          "id": "video",
          "type": "video",
          "min": 0,
          "max": 1
        }
      ],
      "controls": [
