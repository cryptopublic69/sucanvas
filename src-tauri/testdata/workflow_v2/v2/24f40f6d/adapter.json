            "if": {
              "cond": {
                "any": [
                  {
                    "empty": {
                      "trim": {
                        "control": "secondaryLoraName"
                      }
                    }
                  },
                  {
                    "truthy": {
                      "control": "secondaryLoraBypassed"
                    }
                  }
                ]
              },
              "then": {
                "var": "secondaryUpstream"
              },
              "else": {
                "link": [
                  "401",
                  0
                ]
              }
            }
          }
        },
        {
          "op": "set",
          "node": "9202",
          "input": "model",
          "value": {
            "var": "secondaryStyle"
          }
        },
        {
          "op": "set",
          "node": "142",
          "input": "model",
          "value": {
            "if": {
              "cond": {
                "any": [
                  {
                    "empty": {
                      "trim": {
                        "control": "loraName"
                      }
                    }
                  },
                  {
                    "truthy": {
                      "control": "loraBypassed"
                    }
                  }
                ]
              },
              "then": {
                "var": "primaryUpstream"
              },
              "else": {
                "link": [
                  "147",
                  0
                ]
              }
            }
          }
        },
        {
          "op": "set",
          "node": "391",
          "input": "model",
          "value": {
            "link": [
              "9202",
              0
            ]
          }
        },
        {
          "op": "set",
          "node": "393",
          "input": "model",
          "value": {
            "link": [
              "9202",
              0
            ]
          }
        },
        {
          "op": "removeNode",
          "node": "221"
        },
        {
          "op": "removeNode",
          "node": "397"
        },
        {
          "op": "addNode",
          "node": "9000",
          "classType": "CreateVideo",
          "inputs": {
            "audio": {
              "if": {
                "cond": {
                  "any": [
                    {
                      "truthy": {
                        "control": "secondarySamplingEnabled"
                      }
                    },
                    {
                      "mediaAtLeast": {
                        "port": "secondarySource",
                        "count": 1
                      }
                    }
                  ]
                },
                "then": {
                  "link": [
                    "218",
                    0
                  ]
                },
                "else": {
                  "link": [
                    "218",
                    0
                  ]
                }
              }
            },
            "bit_depth": {
              "const": 8
            },
            "fps": {
              "const": 24.0
            },
            "images": {
              "if": {
                "cond": {
                  "any": [
                    {
                      "truthy": {
                        "control": "secondarySamplingEnabled"
                      }
                    },
                    {
                      "mediaAtLeast": {
                        "port": "secondarySource",
                        "count": 1
                      }
                    }
                  ]
                },
                "then": {
                  "link": [
                    "403",
                    0
                  ]
                },
                "else": {
                  "link": [
                    "259",
                    0
                  ]
                }
              }
            }
          },
          "meta": {
            "title": "Create Final Video"
          }
        },
        {
          "op": "addNode",
          "node": "9001",
          "classType": "SaveVideo",
          "inputs": {
            "codec": {
              "const": "auto"
            },
            "filename_prefix": {
              "date": {
                "if": {
                  "cond": {
                    "any": [
                      {
                        "truthy": {
                          "control": "secondarySamplingEnabled"
                        }
                      },
                      {
                        "mediaAtLeast": {
                          "port": "secondarySource",
                          "count": 1
                        }
                      }
                    ]
                  },
                  "then": {
                    "const": "%date:yyyy-MM-dd%/Minimax_H3"
                  },
                  "else": {
                    "const": "%date:yyyy-MM-dd%/Minimax_H3"
                  }
                }
              }
