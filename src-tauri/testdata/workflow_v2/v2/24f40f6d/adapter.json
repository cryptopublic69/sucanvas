        {
          "op": "set",
          "node": "259",
          "input": "saturation",
          "value": {
            "float": {
              "control": "primarySaturation"
            }
          }
        },
        {
          "op": "set",
          "node": "403",
          "input": "brightness",
          "value": {
            "float": {
              "control": "secondaryBrightness"
            }
          }
        },
        {
          "op": "set",
          "node": "403",
          "input": "contrast",
          "value": {
            "float": {
              "control": "secondaryContrast"
            }
          }
        },
        {
          "op": "set",
          "node": "403",
          "input": "saturation",
          "value": {
            "float": {
              "control": "secondarySaturation"
            }
          }
        },
        {
          "op": "capture",
          "id": "primaryUpstream",
          "value": {
            "input": {
              "node": "147",
              "input": "model"
            }
          }
        },
        {
          "op": "capture",
          "id": "secondaryUpstream",
          "value": {
            "input": {
              "node": "401",
              "input": "model"
            }
          }
        },
        {
          "op": "set",
          "node": "147",
          "input": "lora_name",
          "value": {
            "trim": {
              "control": "loraName"
            }
          },
          "when": {
            "not": {
              "any": [
                {
                  "empty": {
                    "trim": {
                      "control": "loraName"
                    }
                  }
                },
                {
                  "truthy": {
                    "control": "loraBypassed"
                  }
                }
              ]
            }
          }
        },
        {
          "op": "set",
          "node": "147",
          "input": "strength_model",
          "value": {
            "float": {
              "control": "loraStrength"
            }
          },
          "when": {
            "not": {
              "any": [
                {
                  "empty": {
                    "trim": {
                      "control": "loraName"
                    }
                  }
                },
                {
                  "truthy": {
                    "control": "loraBypassed"
                  }
                }
              ]
            }
          }
        },
        {
          "op": "set",
          "node": "401",
          "input": "lora_name",
          "value": {
            "trim": {
              "control": "secondaryLoraName"
            }
          },
          "when": {
