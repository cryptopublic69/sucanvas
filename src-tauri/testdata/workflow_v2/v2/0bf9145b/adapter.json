{
  "engineApiVersion": 2,
  "capability": "image-generation",
  "variant": "image-generation",
  "nodeTypes": {
    "159": "Power Lora Loader (rgthree)"
  },
  "operations": {
    "generate": {
      "label": "生成",
      "outputs": [
        {
          "id": "image",
          "type": "image",
          "min": 0,
          "max": 1
        }
      ],
      "controls": [
        {
          "id": "prompt",
          "type": "textarea",
          "label": "提示词",
          "default": ""
        },
        {
          "id": "negativePrompt",
          "type": "textarea",
          "label": "负向提示词",
          "default": ""
        },
        {
          "id": "width",
          "type": "number",
          "label": "宽",
          "default": 1280,
          "min": 64.0,
          "max": 4096.0,
          "number": "int"
        },
        {
          "id": "height",
          "type": "number",
          "label": "高",
          "default": 720,
          "min": 64.0,
          "max": 4096.0,
          "number": "int"
        },
        {
          "id": "steps",
          "type": "number",
          "label": "步数",
          "default": 8,
          "min": 1.0,
          "max": 1000.0,
          "number": "int"
        },
        {
          "id": "seed",
          "type": "seed",
          "label": "种子"
        },
        {
          "id": "loraName",
          "type": "select",
          "label": "LoRA",
          "default": "",
          "options": {
            "comfyui": {
              "classType": "LoraLoaderModelOnly",
              "input": "lora_name",
              "dirs": [
                "Krea2"
              ]
            }
          },
          "allowEmpty": true
        },
        {
          "id": "modelName",
          "type": "select",
          "label": "模型",
          "default": "",
          "options": {
            "comfyui": {
              "classType": "UNETLoader",
              "input": "unet_name",
              "dirs": [
                "Krea2",
                "Kera2"
              ]
            }
          },
          "allowEmpty": true
        },
        {
          "id": "upscaleEnabled",
          "type": "toggle",
          "label": "输出放大",
          "default": false
        },
        {
          "id": "upscaleMegapixels",
          "type": "number",
          "label": "放大像素数",
          "default": 8.0,
          "min": 0.1,
          "max": 64.0,
          "number": "float"
        }
      ],
      "steps": [
        {
          "op": "set",
          "node": "98",
          "input": "unet_name",
          "value": {
            "path": {
              "control": "modelName"
            }
          },
          "when": {
            "not": {
              "empty": {
                "trim": {
                  "control": "modelName"
                }
              }
            }
          }
        },
        {
          "op": "set",
          "node": "159",
          "input": "lora_1",
          "value": {
            "object": {
              "lora": {
                "trim": {
                  "control": "loraName"
                }
              },
              "on": {
                "const": true
              },
              "strength": {
                "const": 1.0
              }
            }
          },
          "when": {
            "not": {
              "empty": {
                "trim": {
                  "control": "loraName"
                }
              }
            }
          }
        },
        {
          "op": "set",
          "node": "90",
          "input": "text",
          "value": {
            "trim": {
              "control": "prompt"
            }
          }
        },
        {
          "op": "set",
          "node": "153",
          "input": "text",
          "value": {
            "trim": {
              "control": "negativePrompt"
            }
          }
        },
        {
          "op": "set",
          "node": "63",
          "input": "cfg",
          "value": {
            "if": {
              "cond": {
                "empty": {
                  "trim": {
                    "control": "negativePrompt"
                  }
                }
              },
              "then": {
                "const": 1.0
              },
              "else": {
                "const": 1.5
              }
            }
          }
        },
        {
          "op": "set",
          "node": "160",
          "input": "cfg",
          "value": {
            "if": {
              "cond": {
                "empty": {
                  "trim": {
                    "control": "negativePrompt"
                  }
                }
              },
              "then": {
                "const": 1.0
              },
              "else": {
                "const": 1.5
              }
            }
          }
        },
        {
          "op": "set",
          "node": "63",
          "input": "noise_seed",
          "value": {
            "seed": true
          }
        },
        {
          "op": "set",
          "node": "63",
          "input": "steps",
          "value": {
            "int": {
              "control": "steps"
            }
          }
        },
        {
          "op": "set",
          "node": "29",
          "input": "width",
          "value": {
            "int": {
              "control": "width"
            }
          }
        },
        {
          "op": "set",
          "node": "29",
          "input": "height",
          "value": {
            "int": {
              "control": "height"
            }
          }
        },
        {
          "op": "set",
          "node": "63",
          "input": "latent_image",
          "value": {
            "link": [
              "29",
              0
            ]
          }
        },
        {
          "op": "set",
          "node": "161",
          "input": "megapixels",
          "value": {
            "float": {
              "control": "upscaleMegapixels"
            }
          }
        },
        {
          "op": "set",
          "node": "157",
          "input": "images",
          "value": {
            "if": {
              "cond": {
                "truthy": {
                  "control": "upscaleEnabled"
                }
              },
              "then": {
                "link": [
                  "163",
                  0
                ]
              },
              "else": {
                "link": [
                  "30",
                  0
                ]
              }
            }
          }
        }
      ]
    },
    "upscaleImage": {
      "label": "放大图片",
      "inputs": [
        {
          "id": "source",
          "type": "image",
          "min": 1,
          "max": 1
        }
      ],
      "outputs": [
        {
          "id": "image",
          "type": "image",
          "min": 0,
          "max": 1
        }
      ],
      "controls": [
        {
          "id": "megapixels",
          "type": "number",
          "label": "放大像素数",
          "default": 8.0,
          "min": 0.1,
          "max": 64.0,
          "number": "float"
        },
        {
          "id": "modelName",
          "type": "select",
          "label": "模型",
          "default": "",
          "options": {
            "comfyui": {
              "classType": "UNETLoader",
              "input": "unet_name",
              "dirs": [
                "Krea2",
                "Kera2"
              ]
            }
          },
          "allowEmpty": true
        }
      ],
      "steps": [
        {
          "op": "set",
          "node": "98",
          "input": "unet_name",
          "value": {
            "path": {
              "control": "modelName"
            }
          },
          "when": {
            "not": {
              "empty": {
                "trim": {
                  "control": "modelName"
                }
              }
            }
          }
        },
        {
          "op": "addNode",
          "node": "infinite_canvas_image_upscale_source",
          "classType": "LoadImage",
          "inputs": {
            "image": {
              "media": {
                "port": "source",
                "index": 0
              }
            }
          }
        },
        {
          "op": "set",
          "node": "161",
          "input": "image",
          "value": {
            "link": [
              "infinite_canvas_image_upscale_source",
              0
            ]
          }
        },
        {
          "op": "set",
          "node": "161",
          "input": "megapixels",
          "value": {
            "float": {
              "control": "megapixels"
            }
          }
        },
        {
          "op": "set",
          "node": "157",
          "input": "images",
          "value": {
            "link": [
              "161",
              0
            ]
          }
        }
      ]
    }
  }
}
